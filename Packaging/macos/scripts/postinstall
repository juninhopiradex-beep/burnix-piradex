#!/bin/bash
# BURNIX — pos-instalacao: remover a quarentena dos bundles instalados
# (plugin nao assinado/notarizado: evita o aviso do Gatekeeper ao abrir no DAW)
xattr -cr "/Library/Audio/Plug-Ins/VST3/BURNIX by PIRADEX.vst3"            2>/dev/null || true
xattr -cr "/Library/Audio/Plug-Ins/Components/BURNIX by PIRADEX.component" 2>/dev/null || true
exit 0
